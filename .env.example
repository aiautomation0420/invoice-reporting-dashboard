# Copy this file to .env.local and fill in the values.
# Supabase dashboard > Project Settings > API Keys (and Data API for the URL).

# Project URL, e.g. https://abcdefgh.supabase.co  (also needed in Vercel)
SUPABASE_URL=

# Publishable key (sb_publishable_...) or the legacy "anon" key. Read-only thanks to RLS. (also needed in Vercel)
SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) or the legacy "service_role" key.
# ONLY for the seed script on your computer. Never put this in Vercel or share it.
SUPABASE_SECRET_KEY=
