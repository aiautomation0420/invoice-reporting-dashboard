# Copy this file to .env.local and fill in the values.
# Supabase dashboard > Project Settings > API Keys (and Data API for the URL).

# Project URL, e.g. https://abcdefgh.supabase.co  (also needed in Vercel)
SUPABASE_URL=

# Publishable key (sb_publishable_...). After supabase/security-hardening.sql it can only READ demo rows. (also needed in Vercel)
SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). ONLY on your computer: for the seed script and for DATA_SCOPE=all.
# Never put this in Vercel or share it.
SUPABASE_SECRET_KEY=

# Which rows to show: demo (default, the public site) | all | real.
# all / real need the secret key and are refused on Vercel. Use them locally to see n8n's real invoices.
DATA_SCOPE=demo

# true = show links to n8n runs and to original Gmail/Drive files. Leave false (or unset) on Vercel.
SHOW_PRIVATE_LINKS=false
